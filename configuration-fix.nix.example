# 📄 機器獨用檔範本：configuration-fix.nix
#
# 用途：各機自己的開機參數與 nixpkgs 設定（CPU 調頻參數等機器專屬項目）。
#
# 使用方式：
#   ① cp configuration-fix.nix.example configuration-fix.nix
#   ② 依本機硬體修改 boot.kernelParams
#   ③ 實體檔已被 local-files.txt 排除，不會推到 GitHub
#
# 各流派參考（擇一保留）：
#   AMD    ："amd_pstate=active"  # AMD CPPC 原生自主動態調頻 (EPP)
#   NVIDIA ：（Intel CPU 無需 pstate 參數；移除 AMD 那行即可）
#   通用   ："mem_sleep_default=deep" "pcie_aspm=off"
{ pkgs, ... }: {
  hardware.enableAllFirmware = true;
  boot.kernelParams = [
    "mem_sleep_default=deep"
    "pcie_aspm=off"
    # 依本機 CPU 加入："amd_pstate=active"（僅 AMD CPU）
  ];

  nixpkgs.config.permittedInsecurePackages = [
    "electron-41.10.7"
  ];
}
